DEVBRIDGE_URL=https://your-devbridge.azurewebsites.net
DEVBRIDGE_ENROLLMENT_TOKEN=one-use-token-from-dashboard
DEVBRIDGE_AGENT_NAME=Local Android Emulator
APPIUM_URL=http://127.0.0.1:4723
ANDROID_HOME=C:\Users\your-name\AppData\Local\Android\Sdk
JAVA_HOME=C:\Program Files\Microsoft\jdk-17.x.x-hotspot
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_PLATFORM_VERSION=
DEVBRIDGE_POLL_MS=3000
DEVBRIDGE_ALLOW_CONTROLLED=false
DEVBRIDGE_MAX_STEPS=60
DEVBRIDGE_MAX_RUN_SECONDS=600
DEVBRIDGE_RUN_ONCE=false

# Secrets referenced by generated plans stay only in the runner environment.
TEST_USER_EMAIL=tester@example.invalid
TEST_USER_PASSWORD=replace-me
