{
  "name": "@devbridge/automation-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Safety-bounded Appium/UiAutomator2 runner for DevBridge Android test jobs.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "appium": "node scripts/appium.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "setup:android": "node scripts/appium.mjs setup",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "webdriverio": "9.30.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "appium": "3.6.0",
    "tsx": "4.23.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion@^5.0.0": "5.0.9"
  }
}
